# Include in the nginx http context. Replace domains and certificate paths.
# DNS: preview.example.net and *.preview.example.net must point to this gateway.
# The certificate must cover BOTH the base name and wildcard. For HTTP, use
# listen 80; remove the ssl_certificate directives and keep $scheme below.
# Only this gateway source should be trusted by runtime.preview.trusted_proxies.
map $http_upgrade $preview_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    server_name preview.example.net *.preview.example.net;
    ssl_certificate /etc/nginx/certs/preview.example.net.crt;
    ssl_certificate_key /etc/nginx/certs/preview.example.net.key;

    location / {
        proxy_pass http://127.0.0.1:47421;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $preview_connection_upgrade;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 60s;
        client_max_body_size 0;
    }
}
