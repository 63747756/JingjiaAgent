# Local acceptance helper. Production installs run on their Linux Docker host.
ARG CLI_IMAGE=jingjiaagent-runtime-installer-cli:verified-local
ARG DAEMON_IMAGE=jingjiaagent-runtime-installer-daemon:verified-local
FROM ${CLI_IMAGE} AS cli
FROM ${DAEMON_IMAGE}
COPY --from=cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
ENTRYPOINT ["/bin/bash"]
