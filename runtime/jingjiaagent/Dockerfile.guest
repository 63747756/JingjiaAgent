FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS runtime-build
WORKDIR /runtime-build
COPY .build/agent-compose-c03302d15e26ad032a6df2048de5d505db5be48b/runtime/javascript/package*.json ./
RUN npm ci
COPY .build/agent-compose-c03302d15e26ad032a6df2048de5d505db5be48b/runtime/javascript/tsconfig.json ./
COPY .build/agent-compose-c03302d15e26ad032a6df2048de5d505db5be48b/runtime/javascript/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git python3 python3-venv tini fonts-noto-cjk fonts-liberation curl jq zip unzip file openssh-client ripgrep && rm -rf /var/lib/apt/lists/*
COPY office/requirements.lock office/requirements.guest.lock /opt/office/
RUN python3 -m venv /opt/office/venv && /opt/office/venv/bin/pip install --no-cache-dir --only-binary=:all: --no-deps -r /opt/office/requirements.lock -r /opt/office/requirements.guest.lock && /opt/office/venv/bin/pip check
ENV PATH="/opt/office/venv/bin:${PATH}" MPLBACKEND=Agg PIP_DISABLE_PIP_VERSION_CHECK=1
RUN npm install --global opencode-ai@1.18.9 pnpm@10.34.5 && npm cache clean --force
# Use the installed package manager; do not download one on the first task.
ENV COREPACK_ENABLE_NETWORK=0 npm_config_manage_package_manager_versions=false
COPY --from=runtime-build /runtime-build /opt/agent-compose-runtime
RUN ln -s /opt/agent-compose-runtime/node_modules/@openai/codex/bin/codex.js /usr/bin/codex && ln -s /opt/agent-compose-runtime/node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude /usr/bin/claude
COPY patches/opencode_bridge.py /opt/agent-compose-runtime/jingjiaagent-opencode.py
COPY patches/opencode_bridge.py /opt/agent-compose-runtime/opencode_bridge.py
COPY patches/opencode_messages.py /opt/agent-compose-runtime/opencode_messages.py
COPY patches/sdk_control.py /opt/agent-compose-runtime/jingjiaagent-sdk-control.py
COPY .build/jingjiaagent-interaction.py /opt/agent-compose-runtime/jingjiaagent-interaction.py
COPY office/package.json office/package-lock.json /opt/office/node/
RUN cd /opt/office/node && npm ci --omit=dev && npm cache clean --force
ENV NODE_PATH=/opt/office/node/node_modules
COPY browser/package.json browser/package-lock.json /opt/jingjiaagent/browser/
# Include the matching browser and Linux libraries in the image: no first-run downloads.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/jingjiaagent/browsers
RUN cd /opt/jingjiaagent/browser && npm ci --omit=dev && node node_modules/playwright/cli.js install --with-deps chromium && npm cache clean --force && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1001 --create-home --shell /usr/sbin/nologin pwuser
RUN apt-get update && apt-get install -y --no-install-recommends acl && rm -rf /var/lib/apt/lists/*
COPY browser/config.json browser/cli.py /opt/jingjiaagent/browser/
RUN chmod 755 /opt/jingjiaagent/browser/cli.py && ln -s /opt/jingjiaagent/browser/cli.py /usr/local/bin/playwright-cli
COPY skills /opt/jingjiaagent/skills
# Task package sources are global defaults, installed after image-build downloads.
# Package managers keep their normal project, user, environment and CLI precedence.
COPY dependencies /opt/jingjiaagent/dependencies
RUN cp /opt/jingjiaagent/dependencies/pip.conf /etc/pip.conf \
    && jingjiaagent_npm_config="$(npm config get globalconfig)" \
    && mkdir -p "$(dirname "$jingjiaagent_npm_config")" \
    && cp /opt/jingjiaagent/dependencies/npmrc "$jingjiaagent_npm_config" \
    && jingjiaagent_opencode_config="$(dirname "$(dirname "$(readlink -f "$(command -v opencode)")")")/etc/npmrc" \
    && mkdir -p "$(dirname "$jingjiaagent_opencode_config")" \
    && cp /opt/jingjiaagent/dependencies/npmrc "$jingjiaagent_opencode_config" \
    && chmod 444 /opt/jingjiaagent/dependencies/pip.conf /opt/jingjiaagent/dependencies/npmrc /etc/pip.conf "$jingjiaagent_npm_config" "$jingjiaagent_opencode_config"
ENV NO_PROXY=localhost,127.0.0.1,mirrors.jingjiamicro.com no_proxy=localhost,127.0.0.1,mirrors.jingjiamicro.com
RUN install -d -m 0755 /etc/opencode
COPY --chmod=444 opencode/managed.json /etc/opencode/opencode.json
COPY guest-entry.sh /usr/local/bin/agent-compose-runtime
RUN chmod 755 /usr/local/bin/agent-compose-runtime && mkdir -p /workspace /data/state /data/runtime /data/logs
ARG JINGJIAAGENT_RUNTIME_PATCH=20
LABEL jingjiaagent.image.revision="${JINGJIAAGENT_RUNTIME_PATCH}" jingjiaagent.component="guest" jingjiaagent.upstream.source="https://github.com/chaitin/agent-compose" jingjiaagent.upstream.commit="c03302d15e26ad032a6df2048de5d505db5be48b" jingjiaagent.runtime.providers="opencode,codex,claude"
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["sleep","infinity"]
