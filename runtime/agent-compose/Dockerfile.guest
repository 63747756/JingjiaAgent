FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS runtime-build
WORKDIR /runtime-build
COPY .build/agent-compose-c03302d15e26ad032a6df2048de5d505db5be48b/runtime/javascript/package*.json ./
RUN npm ci
COPY .build/agent-compose-c03302d15e26ad032a6df2048de5d505db5be48b/runtime/javascript/tsconfig.json ./
COPY .build/agent-compose-c03302d15e26ad032a6df2048de5d505db5be48b/runtime/javascript/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git python3 tini && rm -rf /var/lib/apt/lists/*
RUN npm install --global opencode-ai@1.18.9 && npm cache clean --force
COPY --from=runtime-build /runtime-build /opt/agent-compose-runtime
RUN ln -s /opt/agent-compose-runtime/node_modules/@openai/codex/bin/codex.js /usr/bin/codex && ln -s /opt/agent-compose-runtime/node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude /usr/bin/claude
COPY patches/opencode_bridge.py /opt/agent-compose-runtime/monkeycode-opencode.py
COPY patches/opencode_bridge.py /opt/agent-compose-runtime/opencode_bridge.py
COPY patches/sdk_control.py /opt/agent-compose-runtime/monkeycode-sdk-control.py
COPY .build/monkeycode-interaction.py /opt/agent-compose-runtime/monkeycode-interaction.py
RUN ln -s /opt/agent-compose-runtime/dist/cli.js /usr/local/bin/agent-compose-runtime && mkdir -p /workspace /data/state /data/runtime /data/logs
ARG MONKEYCODE_RUNTIME_PATCH=21
LABEL org.opencontainers.image.revision="c03302d15e26ad032a6df2048de5d505db5be48b" monkeycode.runtime.patch="${MONKEYCODE_RUNTIME_PATCH}" monkeycode.runtime.providers="opencode"
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["sleep","infinity"]
